@startuml spresense_tcp_stack_layers
skinparam defaultFontName "Noto Sans CJK JP"
skinparam backgroundColor #FEFEFE
skinparam componentStyle rectangle

title Spresense TCP/IP スタック レイヤ構造\n(セマンティックポート名 + スレッド注記)

component "Application Layer\n(security_camera)\n<<thread: TCP Server Task>>" as APP #LightYellow {
  [Frame Queue\n(frame_queue.c)] as APP_FQ
  [MJPEG Protocol\n(mjpeg_protocol.c)] as APP_MJ
  [TCP Server\n(tcp_server.c)] as APP_TCP
  portout "frame_send_out\n(MJPEG batch ~122KB)" as p_frame_send_out
  portin  "error_notify_in\n(FIN/RST 通知)"     as p_error_notify_in

  APP_FQ --> APP_MJ
  APP_MJ --> APP_TCP
  APP_TCP --> p_frame_send_out
  p_error_notify_in --> APP_TCP
}
note right of APP
  TCP_NODELAY 有効
  SO_SNDBUF 262,144 B (256 KB) 要求
  優先度: app/100, stacksize 8192
end note

component "BSD Socket API\n<<call: same thread as caller>>" as BSD #LightCyan {
  portin  "syscall_in"  as p_bsd_in
  portout "syscall_out" as p_bsd_out
  [socket() / send() / recv()\nlisten() / accept()] as BSD_API
  p_bsd_in --> BSD_API
  BSD_API --> p_bsd_out
}

component "NuttX TCP Stack\n(機能無効: NO_STACK)\n<<bypass>>" as NUTTX #LightGray {
  portin  "bypass_in"  as p_nuttx_in
  portout "bypass_out" as p_nuttx_out
  [NET_TCP_NO_STACK=y\nNET_UDP_NO_STACK=y\nNET_ICMP_NO_STACK=y] as NUTTX_NO
  p_nuttx_in -[#gray,dashed]-> NUTTX_NO
  NUTTX_NO -[#gray,dashed]-> p_nuttx_out
}
note right of NUTTX
  NuttX スタックは「窓口だけ」
  TCP_RECVWNDO 等の設定は機能しない
  全 TCP/UDP は usrsock へ委譲
end note

component "usrsock (RPC ブリッジ)\n<<thread: NuttX kernel>>" as USRSOCK #LightGreen {
  portin  "rpc_request_in"   as p_usr_in
  portout "rpc_response_out" as p_usr_out
  [usrsock_rpmsg] as USR_RPMSG
  p_usr_in --> USR_RPMSG
  USR_RPMSG --> p_usr_out
}
note right of USRSOCK
  NET_USRSOCK_PREALLOC_CONNS=6
  NET_USRSOCK_NPOLLWAITERS=1
  IOB プール 8×196B = 1,568 B 経由
end note

component "GS2200M Driver\n(gs2200m.c)\n<<thread: gs2200m, prio 50, stack 2KB>>" as GS_DRV #LightBlue {
  portin  "tx_pkt_in"      as p_drv_tx_in
  portout "spi_tx_out"     as p_drv_spi_out
  portin  "spi_rx_in"      as p_drv_spi_in
  portout "notify_up_out"  as p_drv_notify_out

  [Bulk Transfer Mgr] as DRV_BULK
  component "Packet Queue Mgr\n(pkt_q[16] + notif_q)" as DRV_PKT
  component "TX Buffer\ntx_buff[1500]" as DRV_TX

  p_drv_tx_in --> DRV_BULK
  DRV_BULK --> DRV_PKT
  DRV_PKT --> DRV_TX
  DRV_TX --> p_drv_spi_out

  p_drv_spi_in --> DRV_PKT : "RX"
  DRV_PKT --> p_drv_notify_out : "切断/エラー通知"
}
note right of GS_DRV
  BULK_THRESHOLD 8 KB
  MAX_PKT_LEN 1,500 B
  HAL_TIMEOUT 5 秒 (SPI ブロッキング)
  WR_MAX_RETRY 100
  ★ tx_buff 1 個 = 送信完全直列化
end note

component "SPI Bus (DMA)\n<<HW: 4 MHz>>" as SPI #Khaki {
  portin  "dma_tx_in"  as p_spi_in
  portout "dma_rx_out" as p_spi_out
  [SPI Interface\n4 MHz] as SPI_IF
  p_spi_in --> SPI_IF
  SPI_IF --> p_spi_out
}
note right of SPI
  理論 500 KB/s
  実効 200-300 KB/s
  送信完全直列化
end note

component "GS2200M Module\n(HW + ベンダー SW)\n<<black box>>" as GSMOD #LightCoral {
  portin  "spi_in"        as p_mod_in
  portout "wifi_phy_out"  as p_mod_out
  [Internal TCP/IP Stack\n(ベンダー実装)] as VSTACK
  [Internal Buffers\n(容量不明)] as VBUF
  p_mod_in --> VSTACK
  VSTACK --> VBUF
  VBUF --> p_mod_out
}
note right of GSMOD
  ソフト側から制御不能
  リソース枯渇 → 切断発生
  観測のみ可:
    tcp_health_moving_avg_ms
    tcp_health_total_spikes
end note

component "WiFi 802.11n PHY\n<<HW>>" as WIFI #LightPink {
  portin "wifi_in" as p_wifi_in
  [Wireless Tx/Rx] as WIFI_TX
  p_wifi_in --> WIFI_TX
}

' === レイヤ間接続 (ポート同士、TX path) ===
p_frame_send_out  --> p_bsd_in    : "send(122KB)"
p_bsd_out         --> p_nuttx_in
p_nuttx_out       -[#gray,dashed]-> p_usr_in : "(素通し)"
p_usr_out         --> p_drv_tx_in
p_drv_spi_out     --> p_spi_in    : "1500B/pkt × 約 84 回"
p_spi_out         --> p_mod_in
p_mod_out         --> p_wifi_in

' === RX/Notify path (FIN/RST など) ===
p_drv_notify_out  -[#red,dashed]-> p_error_notify_in : "切断通知 (RST/FIN)"

legend bottom
  **核心事実**: NuttX 設定 NET_TCP_NO_STACK=y により TCP 制御は\n
  すべて GS2200M 内蔵スタックに委譲。NuttX 側で見える設定 (TCP_RECVWNDO 等)\n
  は機能せず、Spresense ソフトから制御できる範囲は usrsock 入口まで。\n
  \n
  **<<thread>> 注記**: 各レイヤの実行スレッド。同一プロセス内でも、\n
  GS2200M ドライバは独立スレッド (prio 50) で動作するため、アプリ送信と\n
  並行して RX 処理が走る。
end legend

@enduml
