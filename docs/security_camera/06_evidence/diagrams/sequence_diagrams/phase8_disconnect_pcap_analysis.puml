@startuml phase8_disconnect_pcap_analysis
!theme plain
skinparam backgroundColor #FEFEFE
skinparam sequenceMessageAlign center
skinparam maxMessageSize 200

title 仮説D: pcap分析による詳細シーケンス (重複ACKエラーカウント蓄積)

participant "Camera\n(30fps)" as CAM
participant "action_queue\n(MAX=7)" as AQ #LightYellow
participant "TCP Thread" as TCP_SP
participant "GS2200M\nInternal Buffer\n(256KB)" as WIFI_BUF #Orange
participant "GS2200M\nWiFi TX" as WIFI_TX #LightBlue
participant "WiFi AP" as AP
participant "PC" as PC

