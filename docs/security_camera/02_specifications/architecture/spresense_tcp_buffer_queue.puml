@startuml spresense_tcp_buffer_queue
skinparam defaultFontName "Noto Sans CJK JP"
skinparam backgroundColor #FEFEFE
skinparam componentStyle rectangle

title Spresense TCP 通信 バッファ/キュー関係図 (ポート In/Out 明示)\n(全層のバッファサイズと所有者を一覧化)

component "Application Layer\n(security_camera)" as APP #LightYellow {
  portin  in_app
  portout out_app

  queue "action_queue\n5/7/9 frames" as AQ
  rectangle "MJPEG Batch Buffer\nMAX_BATCH_PACKET ≈ 122 KB\n(BATCH_SIZE=2)" as MJBUF #LightGreen
  rectangle "TCP SO_SNDBUF\n要求 262,144 B (256 KB)" as SNDBUF #LightCyan

  AQ --> MJBUF : "7 frames pop"
  MJBUF --> SNDBUF : "send(jpeg_batch)"
  SNDBUF --> out_app
  in_app --> SNDBUF : "RST/FIN"
}
note right of APP
  config.h:122-124 (action_queue)
  mjpeg_protocol.h:43,47 (BATCH=2)
  tcp_server.c:170 (SO_SNDBUF)
end note

component "NuttX usrsock 層" as USRSOCK #LightGreen {
  portin  in_usr
  portout out_usr

  rectangle "usrsock 事前確保\nPREALLOC_CONNS = 6 sockets" as USRCONN
  queue "IOB プール\n8 × 196 B = 1,568 B" as IOB #Salmon

  in_usr --> USRCONN : "socket() 経由"
  USRCONN --> IOB : "RPC メッセージ分割"
  IOB --> out_usr
  in_usr <-- IOB : "受信側"
}
note right of USRSOCK
  IOB はNuttX 全体で共有、極小
  IOB_THROTTLE=0 (流量制御なし)
end note

component "GS2200M Driver\n(gs2200m.c)" as GS_DRV #LightBlue {
  portin  in_drv
  portout out_drv
  portin  rx_drv
  portout notify_drv

  rectangle "tx_buff\n[1 個 × 1,500 B]" as TXBUF #Salmon
  queue "pkt_q[16]\n受信キュー × 16 ソケット\n(per-cid)" as PKTQ
  queue "notif_q\nMAX_NOTIF_Q = 18 通知" as NOTIFQ #Salmon
  rectangle "Response Msg Queue\nNRESPMSG = 18" as RESPQ

  in_drv --> TXBUF : "1,500 B/転送"
  TXBUF --> out_drv : "DMA via SPI"

  rx_drv --> PKTQ
  PKTQ --> NOTIFQ : "(切断/エラー検知)"
  NOTIFQ --> notify_drv : "切断通知 → 上位"
  RESPQ -[hidden]-> NOTIFQ
}
note right of GS_DRV
  tx_buff 1 個 = 完全直列化
  MAX_PKT_LEN 1,500 B
  pkt_q_cnt[16] で per-cid 監視
end note

component "SPI Bus" as SPI #Khaki {
  portin  in_spi
  portout out_spi

  rectangle "SPI 4 MHz\nHAL_TIMEOUT 5 秒\nWR_MAX_RETRY 100" as SPI_IF #Salmon

  in_spi --> SPI_IF
  SPI_IF --> out_spi
}
note right of SPI
  理論 500 KB/s, 実効 200-300 KB/s
  BULK_THRESHOLD 8 KB で bulk モード切替
end note

component "GS2200M Module\n(ブラックボックス)" as GSMOD #LightCoral {
  portin  in_gsmod
  portout out_gsmod

  queue "Internal Buffers\n容量不明 (ベンダー仕様)" as VBUF #Salmon

  in_gsmod --> VBUF : "送信"
  VBUF --> out_gsmod : "WiFi へ"
}
note right of GSMOD
  ソフト側から制御不能
  枯渇時に切断 (RST)
  観測手段: tcp_health_moving_avg_ms
            tcp_health_total_spikes
end note

' レイヤ間接続 (ポート同士)
out_app      --> in_usr      : "send(~122 KB)"
out_usr      --> in_drv      : "TX path"
out_drv      --> in_spi      : "1500B × N 回"
out_spi      --> in_gsmod
out_gsmod    -[#blue,dashed]-> rx_drv : "RX path (受信)"
notify_drv   --> in_app      : "切断通知 (RST/FIN)"

note as RAM #LightYellow
  **🧠 全体メモリ予算**
  CONFIG_RAM_SIZE = 1,572,864 B = **1.5 MB**
  この中に NuttX カーネル + 全ドライバ + 全アプリバッファ
  (上記すべて) を収める必要がある。
  GS2200M ドライバスタック自体は 2,048 B、優先度 50。
end note

@enduml
