@startuml spresense_deployment_topology
skinparam defaultFontName "Noto Sans CJK JP"
skinparam backgroundColor #FEFEFE

title Spresense デプロイメント / 物理トポロジ (ポート In/Out 明示版)\n(物理インタフェース CSI/SPI/USB/WiFi RF/Ethernet を portin/portout で表現)

' ==================== 現状トポロジ ====================
package "🟢 現状トポロジ (Phase 1-11)" #LightGreen {

  node "ISX012 カメラ\n(Sony 5MP CMOS)" as CAM {
    portout "CSI out\n(parallel)" as p_cam_out
  }

  node "Spresense メインボード\nCXD5602 / Cortex-M4F×6 @156MHz" as SPR_MAIN {
    portin  "CSI in\n(parallel 8/10 bit)" as p_main_csi
    portout "SPI MOSI\n(4 MHz, master)" as p_main_spi_mosi
    portin  "SPI MISO" as p_main_spi_miso
    portout "拡張コネクタ\n(B2B)" as p_main_exp_out
    portin  "拡張コネクタ" as p_main_exp_in

    component "NuttX RTOS\n+ security_camera app" as NUTTX
    component "ISX012\nカメラ I/F" as ISX_IF

    p_main_csi --> ISX_IF
    ISX_IF --> NUTTX
    NUTTX --> p_main_spi_mosi
    p_main_spi_miso --> NUTTX
    NUTTX --> p_main_exp_out
    p_main_exp_in --> NUTTX
  }

  node "GS2200M モジュール\n(WiFi 802.11n)" as GS2200M_MOD {
    portin  "SPI MOSI in" as p_gs_spi_in
    portout "SPI MISO out" as p_gs_spi_out
    portout "WiFi RF TX" as p_gs_rf_tx
    portin  "WiFi RF RX" as p_gs_rf_rx

    component "ベンダー TCP/IP\n(ブラックボックス)" as VTCP
    component "WiFi PHY" as PHY

    p_gs_spi_in --> VTCP
    VTCP --> p_gs_spi_out
    VTCP --> PHY
    PHY --> p_gs_rf_tx
    p_gs_rf_rx --> PHY
  }

  node "Spresense 拡張ボード" as SPR_EXT {
    portin  "拡張コネクタ" as p_ext_main_in
    portout "拡張コネクタ" as p_ext_main_out
    portout "USB CDC-ACM TX\n(12 Mbps)" as p_ext_usb_tx
    portin  "USB CDC-ACM RX" as p_ext_usb_rx
    portout "SD I/F" as p_ext_sd

    component "USB CDC-ACM\nコントローラ" as USB_CTRL
    component "SD カード I/F" as SD_IF

    p_ext_main_in --> USB_CTRL
    USB_CTRL --> p_ext_main_out
    USB_CTRL --> p_ext_usb_tx
    p_ext_usb_rx --> USB_CTRL
    USB_CTRL --> p_ext_sd
  }

  node "PC (Linux/WSL2)" as PC {
    portin  "USB Host RX" as p_pc_usb_rx
    portout "USB Host TX" as p_pc_usb_tx
    portin  "WiFi NIC RX" as p_pc_wifi_rx
    portout "WiFi NIC TX" as p_pc_wifi_tx

    component "Rust_ws/\nsecurity_camera_viewer\n(pipeline.rs, 3 thread)" as PCAPP

    p_pc_usb_rx --> PCAPP
    PCAPP --> p_pc_usb_tx
    p_pc_wifi_rx --> PCAPP
    PCAPP --> p_pc_wifi_tx
  }

  node "WiFi AP\n(802.11n)" as AP {
    portin  "WiFi RF in" as p_ap_in
    portout "WiFi RF out" as p_ap_out
  }

  ' === 物理接続 (port-to-port) ===
  p_cam_out          --> p_main_csi      : "CSI parallel"
  p_main_exp_out     --> p_ext_main_in   : "拡張コネクタ B2B"
  p_ext_main_out     --> p_main_exp_in
  p_main_spi_mosi    --> p_gs_spi_in     : "**SPI MOSI 4 MHz**\n(理論 500 KB/s)"
  p_gs_spi_out       --> p_main_spi_miso : "SPI MISO"
  p_ext_usb_tx       --> p_pc_usb_rx     : "**USB CDC-ACM 12 Mbps**\n(= 1.5 MB/s)"
  p_pc_usb_tx        --> p_ext_usb_rx
  p_gs_rf_tx         --> p_ap_in         : "**WiFi 802.11n**"
  p_ap_out           --> p_gs_rf_rx
  p_ap_out           --> p_pc_wifi_rx    : "WiFi 802.11n"
  p_pc_wifi_tx       --> p_ap_in
}

' ==================== 候補 A: ESP32-S3 ====================
package "🟡 候補 A: ESP32-S3 移行 (低コスト)" #LightYellow {
  node "ISX012 カメラ\n(再利用)" as CAM_A {
    portout "CSI out" as p_cam_a_out
  }

  node "ESP32-S3\n(Cortex-M4F dual-core, WiFi 内蔵)" as ESP {
    portin  "CSI in\n(要 PCB 設計)" as p_esp_csi
    portout "WiFi RF TX 内蔵\n(150 Mbps)" as p_esp_rf_tx
    portin  "WiFi RF RX 内蔵" as p_esp_rf_rx
    portout "USB UART (debug)" as p_esp_dbg

    component "FreeRTOS / NuttX 移植" as ESP_OS
    component "ISX012 ドライバ" as ESP_CAM_DRV

    p_esp_csi --> ESP_CAM_DRV
    ESP_CAM_DRV --> ESP_OS
    ESP_OS --> p_esp_rf_tx
    p_esp_rf_rx --> ESP_OS
    ESP_OS --> p_esp_dbg
  }

  p_cam_a_out --> p_esp_csi : "CSI parallel"

  note right of ESP
    **メリット**:
    • SPI 4MHz 制約解消 (内蔵 WiFi)
    • Cortex-M4F 互換、移植コスト中
    • 安価 ($5-10)

    **デメリット**:
    • PCB 再設計、カメラ接続要検討
    • Spresense 6-core 並列性は失う
    • ベンダー WiFi スタックは依然 BB 可能性
  end note
}

' ==================== 候補 B: Raspberry Pi CM5 ====================
package "🟡 候補 B: Raspberry Pi CM5 (高機能)" #LightYellow {
  node "ISX012 or 別カメラ" as CAM_B {
    portout "CSI-2 out\n(MIPI 4 lanes)" as p_cam_b_out
  }

  node "Raspberry Pi CM5\nBCM2712 / Cortex-A76 4-core" as RPI {
    portin  "CSI-2 in\n(MIPI 4 lanes)" as p_rpi_csi
    portout "WiFi RF TX 内蔵" as p_rpi_rf_tx
    portin  "WiFi RF RX 内蔵" as p_rpi_rf_rx
    portout "Gigabit Ethernet TX\n(1 Gbps)" as p_rpi_eth_tx
    portin  "Gigabit Ethernet RX" as p_rpi_eth_rx
    portout "USB 3.0 Host" as p_rpi_usb3

    component "Linux Kernel" as RPI_K
    component "V4L2 + HW JPEG/H.264" as RPI_V4L2
    component "内蔵 WiFi / GigE" as RPI_NET

    p_rpi_csi --> RPI_V4L2
    RPI_V4L2 --> RPI_K
    RPI_K --> RPI_NET
    RPI_NET --> p_rpi_rf_tx
    p_rpi_rf_rx --> RPI_NET
    RPI_NET --> p_rpi_eth_tx
    p_rpi_eth_rx --> RPI_NET
    RPI_K --> p_rpi_usb3
  }

  p_cam_b_out --> p_rpi_csi : "CSI-2 MIPI"

  note right of RPI
    **メリット**:
    • H.264 HW エンコード対応 (Phase 1B/2A 必須)
    • Linux なので開発生産性高
    • Ethernet 経由なら帯域余裕大 (1 Gbps)
    • V4L2 統一でドライバ層共通化

    **デメリット**:
    • Spresense 資産 (NuttX/SDK) ほぼ放棄
    • 消費電力 +5W 程度
    • 価格 $50-90
  end note
}

' ==================== 候補 C: USB 経由切替 ====================
package "🟢 候補 C: USB 経由切替 (現ハード継続)" #LightGreen {
  node "Spresense (現状ハード)" as SPR_USB {
    portout "USB CDC-ACM TX" as p_spr_usb_tx
    portin  "USB CDC-ACM RX" as p_spr_usb_rx
  }
  node "PC (USB Host)" as PC_USB {
    portin  "USB Host RX" as p_pc2_usb_rx
    portout "USB Host TX" as p_pc2_usb_tx
  }

  p_spr_usb_tx  --> p_pc2_usb_rx  : "**USB CDC-ACM 12 Mbps**\n(GS2200M 廃止、TCP 経由しない)"
  p_pc2_usb_tx  --> p_spr_usb_rx

  note right of SPR_USB
    **メリット**:
    • ハード変更なし
    • USB 12 Mbps 安定 (= 1.5 MB/s, SPI 4MHz の 5 倍)
    • ADR-001 (TTY Raw Mode) 既に検証済み

    **デメリット**:
    • ケーブル接続必須 (WiFi のメリット消失)
    • PC 側 viewer 改修必要
    • 有線距離制約 (~5m まで)
  end note
}

' ==================== 比較表 ====================
note as COMPARE
  **🎯 ADR-006 GATE-1 判定基準 (物理ポート視点)**:
  | 候補 | 帯域 | 物理 I/F | 移植コスト | Spresense 資産 |
  |---|---|---|---|---|
  | 現状  | 200-300 KB/s | CSI + SPI 4MHz + USB 12Mbps + WiFi | 0 | 完全維持 |
  | A: ESP32-S3 | 150 Mbps | CSI + WiFi (内蔵, SPI 不要) | 中 (+15週) | 一部維持 |
  | B: RPi CM5  | 1 Gbps | CSI-2 + GigE + WiFi + USB3 | 大 | ほぼ放棄 |
  | C: USB 経由 | 12 Mbps | USB CDC-ACM のみ (GS2200M 廃止) | 小 | 完全維持 |

  **読み方**: 各候補が「**どの物理 I/F を使うか / 不要にするか**」で
  ハード移行の判断材料を提供。
end note

@enduml
