@startuml spresense_deployment_current
skinparam defaultFontName "Noto Sans CJK JP"
skinparam backgroundColor #FEFEFE

title 🟢 現状トポロジ (Phase 1-11)\n3 領域構成: Spresense 物理アセンブリ / PC / WiFi AP\n(共有メディアはインタフェース表記で集約)

' ================================================================
' 領域 1: Spresense 物理アセンブリ
' ================================================================
frame "🔧 Spresense 物理アセンブリ\n(1 つのハードウェアパッケージ)" as SPR_ASSEMBLY #LightYellow {

  node "ISX012 カメラ\n(Sony 5MP CMOS)" as CAM #LightBlue {
    portout "CSI out\n(parallel)" as p_cam_out
  }

  node "Spresense メインボード\nCXD5602 / Cortex-M4F×6 @156MHz" as SPR_MAIN #LightGreen {
    portin  "CSI in\n(parallel 8/10 bit)" as p_main_csi
    portout "SPI MOSI\n(4 MHz, master)" as p_main_spi_mosi
    portin  "SPI MISO" as p_main_spi_miso
    portout "拡張コネクタ\n(B2B)" as p_main_exp_out
    portin  "拡張コネクタ" as p_main_exp_in

    component "NuttX RTOS\n+ security_camera app" as NUTTX
    component "ISX012\nカメラ I/F" as ISX_IF

    p_main_csi --> ISX_IF
    ISX_IF --> NUTTX
    NUTTX --> p_main_spi_mosi
    p_main_spi_miso --> NUTTX
    NUTTX --> p_main_exp_out
    p_main_exp_in --> NUTTX
  }

  node "GS2200M モジュール\n(WiFi 802.11n)" as GS2200M_MOD #LightCoral {
    portin  "SPI MOSI in" as p_gs_spi_in
    portout "SPI MISO out" as p_gs_spi_out

    component "ベンダー TCP/IP\n(ブラックボックス)" as VTCP
    component "WiFi PHY\n+ アンテナ" as PHY

    p_gs_spi_in --> VTCP
    VTCP --> p_gs_spi_out
    VTCP --> PHY
    PHY --> VTCP
  }

  node "Spresense 拡張ボード" as SPR_EXT #PaleGreen {
    portin  "拡張コネクタ" as p_ext_main_in
    portout "拡張コネクタ" as p_ext_main_out
    portout "SD I/F" as p_ext_sd

    component "USB CDC-ACM\nコントローラ" as USB_CTRL
    component "SD カード I/F" as SD_IF

    p_ext_main_in --> USB_CTRL
    USB_CTRL --> p_ext_main_out
    USB_CTRL --> p_ext_sd
  }

  ' === Spresense アセンブリ内部の物理接続 (基板上配線) ===
  p_cam_out          --> p_main_csi      : "CSI parallel\n(基板上配線)"
  p_main_exp_out     --> p_ext_main_in   : "拡張コネクタ B2B"
  p_ext_main_out     --> p_main_exp_in
  p_main_spi_mosi    --> p_gs_spi_in     : "**SPI MOSI 4 MHz**"
  p_gs_spi_out       --> p_main_spi_miso : "SPI MISO"
}

' ================================================================
' 領域 2: PC (Linux/WSL2)
' ================================================================
frame "💻 PC (ホスト)\n(別筐体)" as PC_REGION #LightCyan {

  node "PC (Linux/WSL2)" as PC #White {
    component "Rust_ws/\nsecurity_camera_viewer\n(pipeline.rs, 3 thread)" as PCAPP
  }
}

' ================================================================
' 領域 3: WiFi AP
' ================================================================
frame "📡 WiFi AP\n(別筐体, 家庭/事務所ルーター)" as AP_REGION #LightPink {

  node "WiFi AP\n(802.11n)" as AP #White {
    component "AP\nWireless Bridge" as AP_BRIDGE
  }
}

' ================================================================
' 領域間の共有メディア (インタフェース表記でハブ化)
' ================================================================

' --- WiFi 802.11n 電波 (3 ノード共有メディア) ---
() "📶 **WiFi 802.11n**\n(無線電波, 共有メディア)" as IF_WIFI

PHY        -- IF_WIFI : "アンテナ送受信"
AP_BRIDGE  -- IF_WIFI : "AP 提供"
PCAPP      -- IF_WIFI : "PC NIC"

' --- USB CDC-ACM ケーブル (2 ノード間ケーブル) ---
() "🔌 **USB CDC-ACM**\n(有線ケーブル, 12 Mbps = 1.5 MB/s)" as IF_USB

USB_CTRL   -- IF_USB : "Spresense 側"
PCAPP      -- IF_USB : "PC USB Host 側"

note as PROFILE
  **🟢 現状の領域構成** (3 物理領域):
  ① Spresense 物理アセンブリ (1 つのハード筐体)
     ・ISX012 カメラ + メインボード + GS2200M + 拡張ボード
     ・基板上配線で内部接続 (CSI / SPI 4MHz / B2B コネクタ)
  ② PC (別筐体): Linux/WSL2 ホスト
  ③ WiFi AP (別筐体): 家庭/事務所等のルーター

  **領域間の共有メディア** (インタフェース表記で集約):
  📶 WiFi 802.11n: 3 ノード (Spresense / PC / AP) が共有する無線電波
  🔌 USB CDC-ACM: Spresense 拡張ボード ↔ PC の有線ケーブル

  **構造的天井** (詳細: SPRESENSE_TCP_CONSTRAINTS.md §10):
  ・SPI 4MHz 律速 (Spresense アセンブリ内部の Spresense ↔ GS2200M 間)
  ・GS2200M 内部バッファはベンダー仕様 (制御不能)
  ・Phase 1.5 実測 11fps = 目標 30fps の 37%
end note

@enduml
