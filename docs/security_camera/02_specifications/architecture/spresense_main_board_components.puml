@startuml spresense_main_board_components
skinparam defaultFontName "Noto Sans CJK JP"
skinparam backgroundColor #FEFEFE
skinparam componentStyle rectangle

title 🟢 Spresense メインボード ソフトウェアコンポーネント デプロイ図 (現状)\n(CXD5602 / Cortex-M4F×6 @156MHz, 1.5MB RAM)\nApp 層は機能/役割単位で集約 + バッファ/キュー構造を統合表示

frame "🔧 Spresense メインボード\nCXD5602 / Cortex-M4F×6 @156MHz, RAM 1.5 MB" as MAIN_BOARD #LightYellow {

  ' ==============================================================
  ' 物理ポート (メインボード境界、1:1 のため IF 不要)
  ' ==============================================================
  portin  "CSI in\n(parallel 8/10 bit)"  as p_csi_in
  portout "SPI MOSI\n(4 MHz, master)"     as p_spi_mosi_out
  portin  "SPI MISO"                       as p_spi_miso_in
  portout "拡張コネクタ B2B\n(out)"          as p_b2b_out
  portin  "拡張コネクタ B2B\n(in)"           as p_b2b_in

  ' ==============================================================
  ' ① Application Layer (機能/役割で集約)
  ' ==============================================================
  package "① Application Layer\n<<thread: app, prio 100, stack 8KB>>" as APP_LAYER #LightGreen {

    component "📷 カメラキャプチャ &\nJPEG エンコード" as F_CAPTURE
    note bottom of F_CAPTURE
      実装: camera_manager.c + encoder_manager.c
      役割: V4L2 クライアント / JPEG 圧縮制御
    end note

    queue "g_action_queue\n5/7/9 frames (動的)\n~360 KB peak" as Q_ACTION #LightCyan
    note bottom of Q_ACTION
      実装: frame_queue.c
      config.h:122-124
    end note

    component "📦 プロトコル & バッチ化" as F_PROTOCOL
    note bottom of F_PROTOCOL
      実装: mjpeg_protocol.c + protocol_handler.c
      役割: 0xCAFEBABF batch + CRC-16, BATCH_SIZE=2
    end note

    rectangle "MJPEG batch buffer\n~122 KB" as B_MJPEG #LightCyan

    component "🌐 WiFi/TCP トランスポート" as F_TCP
    note bottom of F_TCP
      実装: tcp_server.c + wifi_manager.c
      役割: TCP_NODELAY, SO_SNDBUF 256KB 要求
    end note

    component "🔌 USB トランスポート" as F_USB
    note bottom of F_USB
      実装: usb_transport.c
      役割: USB CDC-ACM 経由送信
    end note

    component "🎛️ 適応制御\n(Phase 10/11)" as F_CONTROL
    note bottom of F_CONTROL
      実装: fps_controller.c + frame_statistics.c
            + enhanced_control.h
      役割: PID + 多変数適応制御
    end note

    component "📊 モニタリング" as F_MON
    note bottom of F_MON
      実装: perf_logger.c
      役割: metrics 58B (3 sec)
    end note

    component "🧵 スレッド & ライフサイクル" as F_LIFECYCLE
    note bottom of F_LIFECYCLE
      実装: camera_app_main.c + camera_threads.c
      役割: spawn/join, 優先度管理
    end note
  }

  ' ==============================================================
  ' ② NuttX Kernel Layer
  ' ==============================================================
  package "② NuttX Kernel Layer\n<<kernel: nuttx>>" as NUTTX_LAYER #LightBlue {

    component "V4L2 driver\n(ISX012 RING mode)" as V4L2_DRV
    queue "V4L2 RING buffer\n3 × 64 KB = 192 KB\n(ADR-003)" as B_V4L2 #LightCyan

    component "BSD socket / usrsock RPC\n(NET_TCP_NO_STACK=y)" as USRSOCK
    queue "IOB プール\n8 × 196 B = 1,568 B" as B_IOB #Salmon

    component "GS2200M Driver\n<<thread: gs2200m, prio 50, stack 2KB>>" as GS_DRV
    rectangle "🔴 ★ tx_buff [1×1500B] ★\n=送信完全直列化=" as B_TXBUFF #Red
    queue "pkt_q[16]\n(per-cid)" as Q_PKT
    queue "notif_q\n(MAX_NOTIF_Q=18)" as Q_NOTIF #Salmon

    component "USB CDC-ACM driver" as USB_DRV
    rectangle "USB TX buffer 8 KB" as B_USB #LightCyan
  }

  ' ==============================================================
  ' データフロー (IF は本当に必要な fan-out のみに限定)
  ' ==============================================================

  ' --- カメラキャプチャ経路 (1:1 直結) ---
  p_csi_in     --> V4L2_DRV
  V4L2_DRV     --> B_V4L2
  B_V4L2       --> F_CAPTURE : "VIDIOC_DQBUF"
  F_CAPTURE    --> Q_ACTION : "frame 投入"

  ' --- バッチ化 (action_queue → MJPEG, 1:1) ---
  Q_ACTION     --> F_PROTOCOL : "frame pop ×2"
  F_PROTOCOL   --> B_MJPEG : "batch 化"

  ' --- 🟡 真の fan-out: MJPEG batch → TCP / USB の 2 経路 ---
  () "batch 配信" as IF_BATCH_OUT
  B_MJPEG      --> IF_BATCH_OUT
  IF_BATCH_OUT --> F_TCP : "WiFi 経路"
  IF_BATCH_OUT --> F_USB : "USB 経路"

  ' --- TCP → IOB → GS2200M Driver (1:1 直結) ---
  F_TCP        --> USRSOCK : "send(122KB)"
  USRSOCK      --> B_IOB
  B_IOB        --> GS_DRV
  GS_DRV       --> B_TXBUFF
  B_TXBUFF     --> p_spi_mosi_out : "1500B × 約 84 回"

  ' --- 受信経路 (1:1 直結) ---
  p_spi_miso_in --> Q_PKT
  Q_PKT         --> Q_NOTIF : "切断/エラー検知"
  Q_NOTIF       --> F_TCP : "FIN/RST 通知"

  ' --- USB 経路 (1:1 直結) ---
  F_USB        --> B_USB
  B_USB        --> USB_DRV
  USB_DRV      --> p_b2b_out : "USB CDC-ACM"
  p_b2b_in     --> USB_DRV

  ' --- 制御ループ (Phase 10/11, 1:1 直結) ---
  Q_ACTION     --> F_CONTROL : "depth/stats"
  F_CONTROL    --> Q_ACTION : "depth 調整"

  ' --- メトリクス (1:1 直結) ---
  F_MON        --> F_TCP : "metrics 58B"

  ' --- ライフサイクル (1:1 直結) ---
  F_LIFECYCLE  --> F_CAPTURE
  F_LIFECYCLE  --> F_TCP : "spawn"
  F_LIFECYCLE  --> F_USB : "spawn"
}

note as MEM_NOTE #LightYellow
  **🧠 メモリ予算 (1.5 MB 中)**:
  | 領域 | 占有 |
  |---|---|
  | NuttX カーネル + IPL | ~150 KB (10%) |
  | V4L2 RING buffer | 192 KB (13%) ADR-003 |
  | g_action_queue (~7 frames × 50KB) | ~360 KB (24%) |
  | MJPEG batch buffer | 122 KB (8%) |
  | TCP SO_SNDBUF (要求値) | 256 KB (17%) |
  | IOB プール 🔴 | 1.6 KB (0.1%) |
  | tx_buff[1500] 🔴 | 1.5 KB (0.1%) ボトルネック |
  | USB TX buffer | 8 KB (0.5%) |
  | pkt_q[16], notif_q 等 | ~10 KB (0.7%) |
  | アプリ + GS2200M スタック | ~15 KB (1%) |
  | ヒープ余白 | ~400 KB (26%) |
end note

note as RULE_NOTE #LightCyan
  **🟢 統一表記ルール (v5)**:
  • portin/portout: ノード境界の I/O ポート
  • () "name" as IF: **真の fan-out / fan-in のみ** に配置
    (IF を入れることで線重なりが減る場合のみ)
  • 1:1 接続は IF 省略、直結
  • App 層は **機能/役割単位** で集約 (ソースファイルは note に明示)

  **本図で残した IF**:
  • IF_BATCH_OUT (1 source → 2 sinks: TCP + USB)

  **削除した IF (元 v4 から)**:
  • action_queue 周辺 → 直結で十分 (PID も含め 2 接続のみ)
  • IOB プール周辺 → 直結 (TCP 経路のみ実利用)
  • pkt_q, notif_q, metrics 周辺 → 直結
  • CSI / SPI / B2B 物理ポート → 元から直結
end note

@enduml
